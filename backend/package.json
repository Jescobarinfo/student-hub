{
  "name": "uss-student-hub-backend",
  "version": "1.0.0",
  "description": "Backend serverless para USS Student Hub - Sistema de Notificaciones Académicas",
  "main": "index.js",
  "scripts": {
    "build": "tsc && node copy-files.js",
    "dev": "ts-node-dev --respawn --transpile-only lambdas/auth/login.ts",
    "deploy": "node deploy-lambdas.js",
    "deploy:prod": "NODE_ENV=production node deploy-lambdas.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "lint": "eslint . --ext .ts,.js",
    "lint:fix": "eslint . --ext .ts,.js --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "typecheck": "tsc --noEmit",
    "validate": "npm run lint && npm run typecheck && npm run test"
  },
  "keywords": [
    "aws",
    "lambda",
    "serverless",
    "typescript",
    "dynamodb",
    "api-gateway",
    "nextjs",
    "graphql"
  ],
  "author": "Johan Escobar Acosta <jescobar.acosta@outlook.com>",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-api-gateway": "^3.930.0",
    "@aws-sdk/client-cloudfront": "^3.930.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.930.0",
    "@aws-sdk/client-dynamodb": "^3.930.0",
    "@aws-sdk/client-iam": "^3.930.0",
    "@aws-sdk/client-lambda": "^3.930.0",
    "@aws-sdk/client-s3": "^3.931.0",
    "@aws-sdk/client-secrets-manager": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "adm-zip": "^0.5.16",
    "apollo-server-lambda": "^3.13.0",
    "graphql": "^16.12.0",
    "graphql-tag": "^2.12.6",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/aws-lambda": "^8.10.145",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "lambdas/**/*.ts",
      "shared/**/*.ts",
      "!**/*.test.ts",
      "!**/node_modules/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 50,
        "functions": 50,
        "lines": 50,
        "statements": 50
      }
    }
  }
}
